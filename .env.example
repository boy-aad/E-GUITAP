# Copiez ce fichier en .env.local et renseignez les valeurs.
# Ne commitez jamais .env.local (il est ignoré par git).

# Supabase — Project Settings > API Keys
# Ces deux valeurs sont publiques (exposées au navigateur) : la sécurité repose sur les règles RLS.
# N'utilisez JAMAIS la clé secrète (sb_secret_… / service_role) dans une variable VITE_*.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Cloudflare Turnstile (anti-robot du formulaire) — clé publique « Site Key » du widget.
# La clé secrète va UNIQUEMENT dans les secrets Supabase (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=""

# Adresse publique du site en production (liens canoniques, partage, sitemap.xml).
# Exemple : https://www.exemple.com — sans « / » final. Facultatif en développement.
VITE_SITE_URL=""
